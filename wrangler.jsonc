{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sanjeev-gupta-portfolio",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Static site (HTML/CSS/JS/images). Only /api/* reaches the Worker code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Cloudflare Email Routing: the binding can only deliver to this verified
  // destination address, so the endpoint cannot be abused to email anyone else.
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "sanjeev70.gupta@gmail.com"
    }
  ],

  // Max 5 submissions per minute per client IP.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "vars": {
    // Must be an address on the domain that has Email Routing enabled.
    "CONTACT_FROM": "contact@coachsanjeevgupta.in",
    "CONTACT_TO": "sanjeev70.gupta@gmail.com"
  },

  "observability": { "enabled": true }
}
